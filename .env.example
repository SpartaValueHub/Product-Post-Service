# Product-Post Service 환경변수 예시
# 사용법: cp .env.example .env 후 값을 설정하세요. (.env 는 Git에 포함되지 않습니다)

# local 프로필 필수
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/product_post_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-password-here

# Redis — Auth와 동일 인스턴스 (로컬: Auth docker-compose redis / 앱서버: 127.0.0.1)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 이미지 Presigned (미설정 시 Presigned API만 실패)
# S3_BUCKET=
# CLOUDFRONT_BASE_URL=
# AWS_REGION=ap-northeast-2

# dev / prod 프로필 필수
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery:8761/eureka
